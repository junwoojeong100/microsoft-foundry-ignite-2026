{
  "description": "Workshop hosted agent (bring-your-own Responses hello world, gpt-6.1-terra)",
  "definition": {
    "kind": "hosted",
    "protocol_versions": [
      { "protocol": "responses", "version": "2.0.0" }
    ],
    "cpu": "0.5",
    "memory": "1Gi",
    "code_configuration": {
      "runtime": "python_3_13",
      "entry_point": ["python", "main.py"],
      "dependency_resolution": "remote_build"
    },
    "environment_variables": {
      "AZURE_AI_MODEL_DEPLOYMENT_NAME": "gpt-6.1-terra",
      "PYTHONNOUSERSITE": "1"
    }
  }
}
